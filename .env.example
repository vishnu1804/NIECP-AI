# NIECP-AI configuration example — copy to backend/.env and adjust.
# All values are server-side only; never expose them to the frontend.

# Core
NIECP_ENVIRONMENT=development            # production enables strict validation
NIECP_SECRET_KEY=change-me-to-a-long-random-string
NIECP_CORS_ORIGINS=*                     # set explicit origins in production

# Database (PostgreSQL recommended in production)
NIECP_DATABASE_URL=sqlite:///backend/niecp.db
# NIECP_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/niecp

# Optional external LLM (verdicts stay deterministic regardless)
NIECP_LLM_PROVIDER=none                  # none | openai | azure_openai
NIECP_LLM_API_KEY=
NIECP_LLM_MODEL=gpt-4o-mini

# Government API credentials (only enable after official provisioning)
NIECP_APISETU_CLIENT_ID=
NIECP_APISETU_CLIENT_SECRET=
NIECP_DIGILOCKER_CLIENT_ID=
NIECP_DIGILOCKER_CLIENT_SECRET=
NIECP_MySCHEME_API_KEY==
NIECP_ENABLE_OUTBOUND_GOV_CALLS=0        # keep 0 until approvals are in hand

# Email (unset = honestly reported as NOT_CONFIGURED)
NIECP_SMTP_HOST=
NIECP_SMTP_PORT=587
NIECP_SMTP_USER=
NIECP_SMTP_PASSWORD=
NIECP_SMTP_FROM=no-reply@niecp.example.gov.in
NIECP_EMAIL_ENABLED=0

# Uploads & limits
NIECP_MAX_UPLOAD_MB=25
NIECP_RATE_LIMIT_PER_MINUTE=240

# ── Government data providers (server-side only — NEVER exposed to the frontend) ──
# data.gov.in dataset API (free registration at data.gov.in/user/register)
NIECP_DATA_GOV_API_KEY=
NIECP_DATA_GOV_UDYAAM_RESOURCE_ID=
NIECP_DATA_GOV_PINCODE_RESOURCE_ID=
# MCA programmatic access (only when MCA authorizes it)
NIECP_MCA_API_BASE_URL=
NIECP_MCA_CLIENT_ID=
NIECP_MCA_CLIENT_SECRET=
# NSWS API access (only when NSWS authorizes it)
NIECP_NSWS_CLIENT_ID=
NIECP_NSWS_CLIENT_SECRET=
# Per-call behaviour
NIECP_GOV_API_TIMEOUT_SECONDS=12
NIECP_GOV_API_MAX_RETRIES=1

# ── data.gov.in public dataset resource ids (government data upgrade) ──
# NIECP_DATA_GOV_MCA_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
# NIECP_DATA_GOV_CPCB_AIR_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
# NIECP_DATA_GOV_SURFACE_WATER_RESOURCE_ID=19697d76-442e-4d76-aeae-13f8a17c91e1
# NIECP_DATA_GOV_ASI_RESOURCE_ID=ad35de76-4435-403a-8914-7dbaa907e9d6
# NIECP_DATA_GOV_CACHE_TTL_SECONDS=300
